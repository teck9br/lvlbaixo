# ─────────────────────────────────────────────────────────────────────────
# lvlbaixo — variáveis de ambiente
#
# Copie este arquivo para .env.local (`cp .env.example .env.local`) e
# preencha os valores. Nunca faça commit do .env.local.
#
# PÚBLICAS (prefixo NEXT_PUBLIC_): vão para o bundle do navegador. Só
# coloque aqui valores que já são seguros de expor publicamente (URLs,
# a chave "anon" do Supabase — que é pública por design e protegida por
# Row Level Security).
#
# SECRETAS (sem prefixo NEXT_PUBLIC_): usadas só no servidor (API Routes).
# NUNCA prefixe estas com NEXT_PUBLIC_, ou elas vazam para o navegador.
# ─────────────────────────────────────────────────────────────────────────

# --- LiveKit (voz + compartilhamento de tela) ------------------------------
# URL pública do seu projeto LiveKit Cloud (ou servidor self-hosted),
# no formato wss://SEU-PROJETO.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=

# Chaves do LiveKit — Project Settings > Keys no LiveKit Cloud.
# SECRETAS. Usadas só em app/api/livekit/token/route.ts para gerar tokens
# temporários. NUNCA exponha estas no frontend.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase (banco de dados + chat em tempo real) -------------------------
# Project Settings > API no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Chave de serviço (bypassa Row Level Security) — usada apenas
# nas API Routes do servidor para ler/escrever usuários, salas e mensagens.
# NUNCA exponha esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessão -------------------------------------------------------------
# SECRETA. Segredo usado para assinar o cookie de sessão (HMAC-SHA256).
# Gere um valor aleatório forte, ex.: `openssl rand -base64 32`.
SESSION_SECRET=

# --- Aparência (opcional) ------------------------------------------------
NEXT_PUBLIC_APP_NAME=lvlbaixo

# --- Compartilhamento de tela (opcional — já tem defaults sensatos) --------
# Resolução e frame rate alvo. Valores "públicos" pois só afetam a captura
# feita no navegador do próprio usuário.
NEXT_PUBLIC_SCREEN_SHARE_WIDTH=1920
NEXT_PUBLIC_SCREEN_SHARE_HEIGHT=1080
NEXT_PUBLIC_SCREEN_SHARE_FPS=30
NEXT_PUBLIC_SCREEN_SHARE_FPS_FALLBACK=15
NEXT_PUBLIC_SCREEN_SHARE_MAX_BITRATE=3000000
NEXT_PUBLIC_SCREEN_SHARE_MAX_BITRATE_FALLBACK=1500000
NEXT_PUBLIC_MIC_MAX_BITRATE=32000
